        "jsCode": "// ── Event type mapping ───────────────────────────────────────────────────────\nconst EVENT_MAP = {\n  connection_request_sent: 'connection_sent',\n  connection_accepted:     'connection_request_accepted',\n  message_sent:            'message_sent',\n  reply_received:          'every_message_reply_received',\n};\n\nconst body = $json.body ?? $json ?? {};\nconst lead = body.lead ?? body.contact ?? body.prospect ?? {};\n\n// Event type\nconst rawEvent = body.event_type ?? body.event ?? body.type ?? body.action ?? null;\nconst event_type = EVENT_MAP[rawEvent] ?? rawEvent ?? null;\n\n// HeyReach lead ID\nconst heyreach_lead_id =\n  body.leadId    ??\n  body.lead_id   ??\n  body.contactId ??\n  lead.id        ??\n  lead.leadId    ??\n  null;\n\n// LinkedIn URL — normalize\nconst raw_url =\n  body.linkedinUrl  ??\n  body.linkedin_url ??\n  body.profileUrl   ??\n  body.profile_url  ??\n  lead.linkedinUrl  ??\n  lead.linkedin_url ??\n  lead.profileUrl   ??\n  lead.profile_url  ??\n  null;\n\nconst linkedin_url = raw_url\n  ? raw_url.trim().toLowerCase().replace(/^http:/, 'https:').replace(/\\/+$/, '').replace(/\\?.*/, '')\n  : null;\n\n// Name\nconst first_name = body.firstName ?? body.first_name ?? lead.firstName ?? lead.first_name ?? null;\nconst last_name  = body.lastName  ?? body.last_name  ?? lead.lastName  ?? lead.last_name  ?? null;\n\n// Reply text (only for reply events)\nconst raw_reply =\n  body.replyText   ??\n  body.reply_text  ??\n  body.messageText ??\n  body.message     ??\n  body.body        ??\n  lead.replyText   ??\n  (body.recent_messages ?? [])[0]?.message ??\n  null;\n\nconst reply_text = event_type === 'every_message_reply_received' ? (raw_reply ?? null) : null;\n\nreturn [{ json: {\n  event_type,\n  heyreach_lead_id: heyreach_lead_id !== null ? String(heyreach_lead_id) : null,\n  linkedin_url,\n  first_name,\n  last_name,\n  reply_text,\n  raw_payload: JSON.stringify(body),\n} }];"
